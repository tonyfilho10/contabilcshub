generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum PopStatus {
  RASCUNHO
  EM_REVISAO
  APROVADO
  PUBLICADO
  ARQUIVADO
}

enum Cargo {
  AUXILIAR
  ASSISTENTE
  ANALISTA
  COORDENADOR
  CONSULTOR
  AUDITOR
  SOCIO
}

enum TagType {
  PROCESSO
  AREA
  PRIORIDADE
  STATUS
  CUSTOM
}

enum RubricaGrupo {
  FOLHA_NORMAL
  FERIAS
  RESCISAO
  EMPRESA
}

enum RubricaOrigem {
  IMPORTADO
  MANUAL
}

model Pop {
  id           String    @id @default(cuid())
  titulo       String
  descricao    String?
  conteudo     Json?
  status       PopStatus @default(RASCUNHO)
  versao       String    @default("1.0")
  criadoEm    DateTime  @default(now())
  atualizadoEm DateTime  @updatedAt
  publicadoEm  DateTime?

  autorId        String?
  autor          Profile? @relation("PopAutor", fields: [autorId], references: [id])
  mencionadosIds String[]

  tags        PopTag[]
  comentarios Comentario[]
  anexos      Anexo[]
  historico   HistoricoVersao[]

  @@map("pops")
}

model Tag {
  id    String  @id @default(cuid())
  nome  String  @unique
  cor   String  @default("#f97316")
  tipo  TagType @default(CUSTOM)
  icone String?

  pops PopTag[]

  @@map("tags")
}

model PopTag {
  popId String
  tagId String
  pop   Pop    @relation(fields: [popId], references: [id], onDelete: Cascade)
  tag   Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([popId, tagId])
  @@map("pop_tags")
}

model Comentario {
  id        String   @id @default(cuid())
  texto     String
  criadoEm DateTime @default(now())
  popId     String
  autorId   String?
  parentId  String?

  pop       Pop          @relation(fields: [popId], references: [id], onDelete: Cascade)
  autor     Profile?     @relation(fields: [autorId], references: [id])
  parent    Comentario?  @relation("Respostas", fields: [parentId], references: [id])
  respostas Comentario[] @relation("Respostas")

  @@map("comentarios")
}

model Anexo {
  id        String   @id @default(cuid())
  nome      String
  url       String
  tipo      String
  tamanho   Int?
  criadoEm DateTime @default(now())
  popId     String

  pop Pop @relation(fields: [popId], references: [id], onDelete: Cascade)

  @@map("anexos")
}

model HistoricoVersao {
  id        String   @id @default(cuid())
  versao    String
  conteudo  Json?
  descricao String?
  criadoEm DateTime @default(now())
  autorId   String?
  popId     String

  pop   Pop      @relation(fields: [popId], references: [id], onDelete: Cascade)
  autor Profile? @relation(fields: [autorId], references: [id])

  @@map("historico_versoes")
}

// ── Módulo de Anotações ────────────────────────────────────

model PastaAnotacao {
  id        String   @id @default(cuid())
  nome      String
  cor       String   @default("#f97316")
  icone     String?
  criadoEm DateTime @default(now())
  usuarioId String

  anotacoes Anotacao[]

  @@map("pastas_anotacoes")
}

model TagAnotacao {
  id   String @id @default(cuid())
  nome String
  cor  String @default("#6366f1")

  anotacoes AnotacaoTag[]

  @@map("tags_anotacoes")
}

model Anotacao {
  id           String   @id @default(cuid())
  titulo       String
  conteudo     Json?
  criadoEm    DateTime @default(now())
  atualizadoEm DateTime @updatedAt
  usuarioId    String
  pastaId      String?
  mencionadosIds String[]

  pasta PastaAnotacao? @relation(fields: [pastaId], references: [id])
  tags  AnotacaoTag[]

  @@map("anotacoes")
}

model AnotacaoTag {
  anotacaoId String
  tagId      String
  anotacao   Anotacao    @relation(fields: [anotacaoId], references: [id], onDelete: Cascade)
  tag        TagAnotacao @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([anotacaoId, tagId])
  @@map("anotacao_tags")
}

model Profile {
  id        String   @id
  nome      String
  email     String   @unique
  avatar    String?
  cargo     Cargo    @default(AUXILIAR)
  ativo     Boolean  @default(true)
  criadoEm DateTime @default(now())

  popsAutor        Pop[]             @relation("PopAutor")
  comentarios      Comentario[]
  historico        HistoricoVersao[]
  notificacoes     Notificacao[]
  pushSubscriptions PushSubscription[]

  @@map("profiles")
}

// ── Módulo de Rubricas ─────────────────────────────────────

model RubricaMapeamento {
  id           String        @id @default(cuid())
  codigo       String
  descricao    String
  grupo        RubricaGrupo
  lancamento   String?
  contaDebito  String?
  contaCredito String?
  historico    String?
  origem       RubricaOrigem @default(MANUAL)
  criadoEm     DateTime      @default(now())
  atualizadoEm DateTime      @updatedAt

  @@unique([codigo, grupo])
  @@map("rubrica_mapeamentos")
}

// ── Notificações ───────────────────────────────────────────

model Notificacao {
  id           String   @id @default(uuid())
  usuarioId    String
  tipo         String
  titulo       String
  mensagem     String?
  lida         Boolean  @default(false)
  referenciaId String?
  criadoEm    DateTime @default(now())

  usuario Profile @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@index([lida])
  @@map("notificacoes")
}

// ── Push Subscriptions ─────────────────────────────────────

model PushSubscription {
  id        String   @id @default(uuid())
  usuarioId String
  endpoint  String   @unique
  p256dh    String
  auth      String
  criadoEm DateTime @default(now())

  usuario Profile @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@map("push_subscriptions")
}

// ── Módulo de Gestão: Reuniões ────────────────────────────────

model Reuniao {
  id          String    @id @default(cuid())
  tema        String
  status      String    @default("ABERTA")
  criadoEm   DateTime  @default(now())
  encerradoEm DateTime?
  decisoes    Decisao[]

  @@map("reunioes")
}

model Decisao {
  id            String   @id @default(cuid())
  reuniaoId     String
  reuniao       Reuniao  @relation(fields: [reuniaoId], references: [id], onDelete: Cascade)
  descricao     String
  responsavelId String
  prazo         DateTime
  contexto      String
  status        String   @default("PENDENTE")
  criadoEm     DateTime @default(now())
  tarefas       Tarefa[]

  @@map("decisoes")
}

model Tarefa {
  id                String   @id @default(cuid())
  decisaoId         String?
  decisao           Decisao? @relation(fields: [decisaoId], references: [id], onDelete: SetNull)
  descricao         String
  responsavelId     String
  prazo             DateTime
  contexto          String
  status            String   @default("RECEBIDO")
  motivoTravado     String?
  leituraConfirmada Boolean  @default(false)
  criadoPor         String
  criadoEm         DateTime @default(now())
  atualizadoEm     DateTime @updatedAt

  @@map("tarefas")
}

// ── Módulo de Gestão: OKR ─────────────────────────────────────

model Okr {
  id            String      @id @default(cuid())
  titulo        String
  tipo          String
  cluster       String?
  responsavelId String
  ciclo         String
  progresso     Int         @default(0)
  status        String      @default("NO_PRAZO")
  keyResults    KeyResult[]
  criadoEm     DateTime    @default(now())

  @@map("okrs")
}

model KeyResult {
  id        String @id @default(cuid())
  okrId     String
  okr       Okr    @relation(fields: [okrId], references: [id], onDelete: Cascade)
  descricao String
  meta      Float
  atual     Float  @default(0)
  unidade   String

  @@map("key_results")
}

// ── Módulo de Gestão: Rituais ─────────────────────────────────

model Ritual {
  id               String       @id @default(cuid())
  nome             String
  frequencia       String
  duracaoMin       Int
  facilitadorId    String
  participantesIds String[]
  ocorrencias      Ocorrencia[]
  criadoEm        DateTime     @default(now())

  @@map("rituais")
}

model Ocorrencia {
  id            String   @id @default(cuid())
  ritualId      String
  ritual        Ritual   @relation(fields: [ritualId], references: [id], onDelete: Cascade)
  data          DateTime
  ata           String?
  facilitadorId String?
  criadoEm     DateTime @default(now())

  @@map("ocorrencias")
}

// ── Módulo de Gestão: Backlog ─────────────────────────────────

model Backlog {
  id            String   @id @default(cuid())
  nome          String
  descricao     String?
  area          String
  prioridade    String
  status        String   @default("BACKLOG")
  responsavelId String?
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@map("backlog")
}

// ── Módulo de Gestão: Indicadores ─────────────────────────────

model Indicador {
  id            String    @id @default(cuid())
  nome          String
  cluster       String
  responsavelId String
  meta          Float
  unidade       String
  medicoes      Medicao[]
  criadoEm     DateTime  @default(now())

  @@map("indicadores")
}

model Medicao {
  id            String    @id @default(cuid())
  indicadorId   String
  indicador     Indicador @relation(fields: [indicadorId], references: [id], onDelete: Cascade)
  valor         Float
  data          DateTime
  atualizadoPor String
  criadoEm     DateTime  @default(now())

  @@map("medicoes")
}
